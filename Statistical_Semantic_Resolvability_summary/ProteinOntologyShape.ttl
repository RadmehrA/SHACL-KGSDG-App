@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix ex: <http://example.org/shapes#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Shape for PR entries (proteins)
ex:ProteinShape a sh:NodeShape ;
  sh:targetClass oboInOwl:ProteinShape ;

  sh:property [
    sh:path oboInOwl:hasExactSynonym ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path oboInOwl:hasRelatedSynonym ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path oboInOwl:hasDbXref ;
    sh:datatype xsd:string ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path rdfs:comment ;
    sh:datatype xsd:string ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path IAO:0000115 ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path oboInOwl:hasBroadSynonym ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path oboInOwl:hasNarrowSynonym ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path oboInOwl:inSubset ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path dcterms:created ;
    sh:datatype xsd:date ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path rdf:type ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path rdfs:subClassOf ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] .

# Shape for owl:Axiom annotations
ex:AnnotationAxiomShape a sh:NodeShape ;
  sh:targetClass owl:Axiom ;

  sh:property [
    sh:path owl:annotatedSource ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path owl:annotatedProperty ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

# Shape for OWL Restrictions
ex:RestrictionShape a sh:NodeShape ;
  sh:targetClass owl:Restriction ;

  sh:property [
    sh:path owl:onProperty ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path owl:someValuesFrom ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .
